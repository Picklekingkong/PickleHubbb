local function ODFJGGV_fake_script() -- Reshade.MenuController 
	local script = Instance.new('LocalScript', Reshade)

	--// Reshade Menu Controller (Merged from Key, Headerz, and Draggable)
	
	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	
	local screenGui = script.Parent
	local menu = screenGui:WaitForChild("Menu")
	local header = menu:WaitForChild("HeaderButtons")
	local activeBtn = header:WaitForChild("Activetotop")
	local searchBox = header:WaitForChild("Search")
	local scrollingBox = menu:WaitForChild("Effects")
	
	--//////////////////////////////////////////////////////
	--// GUI TOGGLE (Key functionality)
	--//////////////////////////////////////////////////////
	
	local guiEnabled = true
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
	
		if input.KeyCode == Enum.KeyCode.Home then
			guiEnabled = not guiEnabled
			screenGui.Enabled = guiEnabled
		end
	end)
	
	--//////////////////////////////////////////////////////
	--// DRAGGING (Draggable functionality)
	--//////////////////////////////////////////////////////
	
	local dragToggle = false
	local dragStart = nil
	local startPos = nil
	local dragSpeed = 0.15
	
	local function updateDrag(input)
		local delta = input.Position - dragStart
		local position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		TweenService:Create(menu, TweenInfo.new(dragSpeed), {Position = position}):Play()
	end
	
	menu.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragToggle = true
			dragStart = input.Position
			startPos = menu.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragToggle = false
				end
			end)
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			if dragToggle then
				updateDrag(input)
			end
		end
	end)
	
	--//////////////////////////////////////////////////////
	--// SEARCH & ACTIVE TO TOP (Headerz functionality)
	--//////////////////////////////////////////////////////
	
	local activeToTopEnabled = false
	local originalOrder = {}
	
	-- Store original order dynamically
	local function storeOriginalOrder()
		for i, frame in ipairs(scrollingBox:GetChildren()) do
			if frame:IsA("Frame") then
				originalOrder[frame] = i
			end
		end
	end
	
	storeOriginalOrder()
	
	-- Update search visibility
	local function updateSearch()
		local text = string.lower(searchBox.Text)
	
		for _, frame in pairs(scrollingBox:GetChildren()) do
			if frame:IsA("Frame") then
				local button = frame:FindFirstChild("Button")
				local title = button and button:FindFirstChild("FXTitle")
	
				if title and title:IsA("TextLabel") then
					local fxName = string.lower(title.Text)
	
					if text == "" then
						frame.Visible = true
					else
						frame.Visible = string.find(fxName, text) ~= nil
					end
				else
					frame.Visible = true
				end
			end
		end
	end
	
	searchBox:GetPropertyChangedSignal("Text"):Connect(updateSearch)
	
	-- Update order based on active status
	local function updateOrder()
		local activeFrames = {}
		local inactiveFrames = {}
	
		for _, frame in pairs(scrollingBox:GetChildren()) do
			if frame:IsA("Frame") then
				local button = frame:FindFirstChild("Button")
				if button then
					local check = button:FindFirstChild("Check")
					if check and check.Visible then
						table.insert(activeFrames, frame)
					else
						table.insert(inactiveFrames, frame)
					end
				end
			end
		end
	
		local index = 1
	
		if activeToTopEnabled then
			for _, frame in ipairs(activeFrames) do
				frame.LayoutOrder = index
				index += 1
			end
		end
	
		for _, frame in ipairs(inactiveFrames) do
			frame.LayoutOrder = index
			index += 1
		end
	
		-- Restore original order if disabled
		if not activeToTopEnabled then
			for frame, order in pairs(originalOrder) do
				if frame and frame.Parent then
					frame.LayoutOrder = order
				end
			end
		end
	end
	
	-- Toggle button click
	activeBtn.MouseButton1Click:Connect(function()
		activeToTopEnabled = not activeToTopEnabled
	
		-- Visual feedback
		local goal = {
			TextColor3 = activeToTopEnabled and Color3.fromRGB(141, 165, 200) or Color3.fromRGB(255, 255, 255)
		}
	
		TweenService:Create(activeBtn, TweenInfo.new(0.2), goal):Play()
	
		updateOrder()
	end)
	
	-- Watch for check toggles
	local function connectCheckListener(frame)
		local button = frame:FindFirstChild("Button")
		if button then
			local check = button:FindFirstChild("Check")
			if check then
				check:GetPropertyChangedSignal("Visible"):Connect(function()
					if activeToTopEnabled then
						updateOrder()
					end
				end)
			end
		end
	end
	
	-- Connect to existing frames
	for _, frame in pairs(scrollingBox:GetChildren()) do
		if frame:IsA("Frame") then
			connectCheckListener(frame)
		end
	end
	
	-- Handle frames added dynamically
	scrollingBox.ChildAdded:Connect(function(child)
		if child:IsA("Frame") then
			-- Update original order tracking
			local newIndex = 0
			for _, f in pairs(scrollingBox:GetChildren()) do
				if f:IsA("Frame") then
					newIndex += 1
				end
			end
			originalOrder[child] = newIndex
			
			connectCheckListener(child)
		end
	end)
end
