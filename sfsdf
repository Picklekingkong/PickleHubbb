local function IFLADT_fake_script() -- DaCode_7.LocalScript 
	local script = Instance.new('LocalScript', DaCode_7)

	local textBox = script.Parent
	local Lighting = game:GetService("Lighting")
	
	-- UI path
	local ui = textBox:FindFirstAncestor("LightingConfig")
	local colorFrame = ui
		:WaitForChild("Outdoor")
		:WaitForChild("ColorOfOut")
	
	local originalColor = Lighting.OutdoorAmbient
	
	local function parseColor(text)
		text = text:gsub("%s+", "")
	
		-- 🔥 CASE 1: single number ("1", "12", "255")
		if text:match("^%d+$") then
			local n = tonumber(text)
	
			local str = tostring(n)
			local value = tonumber(str .. str .. str)
	
			local clamped = math.clamp(value, 0, 255)
	
			return Color3.fromRGB(clamped, clamped, clamped)
		end
	
		-- 🔥 CASE 2: RGB "255,255,255"
		local r, g, b = text:match("(%d+),(%d+),(%d+)")
		if r and g and b then
			r, g, b = tonumber(r), tonumber(g), tonumber(b)
			r = math.clamp(r, 0, 255)
			g = math.clamp(g, 0, 255)
			b = math.clamp(b, 0, 255)
	
			return Color3.fromRGB(r, g, b)
		end
	
		-- 🔥 CASE 3: HEX "#FFFFFF"
		if text:sub(1,1) == "#" and #text == 7 then
			local ok, color = pcall(function()
				return Color3.fromHex(text)
			end)
			if ok then
				return color
			end
		end
	
		return nil
	end
	
	local function applyColor(color)
		Lighting.OutdoorAmbient = color
	
		if colorFrame then
			colorFrame.BackgroundColor3 = color
		end
	end
	
	textBox.FocusLost:Connect(function(enterPressed)
		if not enterPressed then return end
	
		local input = textBox.Text:lower()
	
		-- reset
		if input == "reset" then
			Lighting.OutdoorAmbient = originalColor
	
			if colorFrame then
				colorFrame.BackgroundColor3 = originalColor
			end
			return
		end
	
		local color = parseColor(textBox.Text)
	
		if color then
			applyColor(color)
		else
			warn("Invalid OutdoorAmbient input")
		end
	end)
end
