local function IRYMFX_fake_script() -- DaCode.LocalScript 
	local script = Instance.new('LocalScript', DaCode)

	local textBox = script.Parent
	local Lighting = game:GetService("Lighting")
	
	-- UI path
	local ui = textBox:FindFirstAncestor("LightingConfig")
	local colorFrame = ui
		:WaitForChild("Ambien")
		:WaitForChild("ColorOfAmbient")
	
	local originalAmbient = Lighting.Ambient
	
	local function clamp(n)
		return math.clamp(n, 0, 255)
	end
	
	local function parseColor(text)
		text = text:gsub("%s+", "") -- remove spaces
	
		-- 🔥 CASE 1: single number (e.g. "1", "12", "255")
		if text:match("^%d+$") then
			local n = tonumber(text)
			n = clamp(n)
	
			local value = tonumber(tostring(n) .. tostring(n) .. tostring(n))
			-- fallback safety if concatenation becomes weird
			if not value then
				value = n
			end
	
			return Color3.fromRGB(n, n, n)
		end
	
		-- 🔥 CASE 2: RGB (255,255,255)
		local r, g, b = text:match("(%d+),(%d+),(%d+)")
		if r and g and b then
			r, g, b = clamp(tonumber(r)), clamp(tonumber(g)), clamp(tonumber(b))
			return Color3.fromRGB(r, g, b)
		end
	
		-- 🔥 CASE 3: HEX (#FFFFFF)
		if text:sub(1,1) == "#" and #text == 7 then
			local ok, color = pcall(function()
				return Color3.fromHex(text)
			end)
			if ok then
				return color
			end
		end
	
		return nil
	end
	
	local function applyColor(color)
		Lighting.Ambient = color
	
		if colorFrame then
			colorFrame.BackgroundColor3 = color
		end
	end
	
	textBox.FocusLost:Connect(function(enterPressed)
		if not enterPressed then return end
	
		local input = textBox.Text:lower()
	
		if input == "reset" then
			Lighting.Ambient = originalAmbient
			if colorFrame then
				colorFrame.BackgroundColor3 = originalAmbient
			end
