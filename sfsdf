		sky.SkyboxRt = skyData.SkyboxRt
		sky.SkyboxUp = skyData.SkyboxUp
	
		sky.SunAngularSize = skyData.SunAngularSize
		sky.MoonAngularSize = skyData.MoonAngularSize
	
		return sky
	end
	
	local function applyAllSkies()
		for _, obj in ipairs(Reshade:GetDescendants()) do
			if obj:IsA("Folder") and isValidFolder(obj) then
				-- Apply all sky configurations to this folder
				for skyName, skyData in pairs(SkyConfigs) do
					if not skyExists(obj, skyName) then
						local sky = createSky(skyName, skyData)
						sky.Parent = obj
					end
				end
			end
		end
	end
	
	--//////////////////////////////////////////////////////
	--// RUN
	--//////////////////////////////////////////////////////
	
	applyAllSkies()
end
