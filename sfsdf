	local playerGui = player:WaitForChild("PlayerGui")
	local Reshade = playerGui:WaitForChild("Reshade")
	
	--//////////////////////////////////////////////////////
	--// CORE LOGIC
	--//////////////////////////////////////////////////////
	
	local function isValidFolder(folder)
		return ValidFolders[string.lower(folder.Name)] == true
	end
	
	local function skyExists(folder, skyName)
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Sky") and child.Name == skyName then
				return true
			end
		end
		return false
	end
	
	local function createSky(skyName, skyData)
		local sky = Instance.new("Sky")
