	-- State
	local toggled = false
	local originalColor = button.BackgroundColor3
	
	-- Store only modified parts
	local modifiedParts = {}
	
	-- Check if part is inside a character
	local function isCharacterPart(part)
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		return false
	end
	
	-- Tween UI
	local function tweenTo(color)
		local tween = TweenService:Create(button, tweenInfo, {
			BackgroundColor3 = color
		})
		tween:Play()
	end
	
	-- APPLY REFLECTION
	local function applyReflection()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
	
				-- ❌ Skip character body parts entirely
				if isCharacterPart(obj) then
					continue
				end
	
				-- ❌ Skip anything already reflective (game-made reflections or custom)
				if obj.Reflectance ~= 0 then
					continue
				end
	
				-- Store original only once
				if modifiedParts[obj] == nil then
					modifiedParts[obj] = obj.Reflectance
				end
	
				obj.Reflectance = 0.1
			end
		end
	end
	
	-- RESTORE ONLY MODIFIED
	local function removeReflection()
		for part, original in pairs(modifiedParts) do
			if part and part.Parent then
				part.Reflectance = original
			end
		end
	
		table.clear(modifiedParts)
	end
	
	-- Hover
	button.MouseEnter:Connect(function()
		if toggled then return end
		tweenTo(hoverColor)
	end)
	
	-- Unhover
	button.MouseLeave:Connect(function()
